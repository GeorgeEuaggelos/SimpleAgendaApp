<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calendar_bg"
    tools:context=".MainActivity">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#bfbfbf"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/headerLogo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Schedly"
            android:textColor="#1A73E8"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/profileIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_user"
            android:contentDescription="User"
            android:scaleType="centerCrop" />
    </LinearLayout>

    <!-- Calendar -->
    <CalendarView
        android:id="@+id/calendarView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Appointments -->
    <androidx.cardview.widget.CardView
        android:id="@+id/appointmentsCard"
        android:layout_width="0dp"
        android:layout_height="155dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#bfbfbf"
        app:cardCornerRadius="10dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/calendarView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/contentCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Λίστα σημειώσεων -->
            <TextView
                android:id="@+id/notesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Σημειώσεις"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/emptyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Δεν υπάρχουν αποθηκευμένες σημειώσεις"
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_gravity="center"
                android:visibility="gone"
                android:padding="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appointmentList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="vertical"
                android:overScrollMode="ifContentScrolls"
                tools:listitem="@layout/item_appointment" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Main Card with content -->
    <androidx.cardview.widget.CardView
        android:id="@+id/contentCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#bfbfbf"
        app:cardCornerRadius="10dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <!-- Τίτλος και Καιρός -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/titleWeatherLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <EditText
                    android:id="@+id/titleField"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:hint="Τίτλος"
                    android:padding="8dp"
                    android:background="#F5F5F5"
                    android:textColor="#000000"
                    android:textColorHint="#777777"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/weatherTemp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/weatherTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°C"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#404040"
                    android:layout_marginStart="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/weatherIcon"
                    app:layout_constraintStart_toEndOf="@id/titleField"/>

                <ImageView
                    android:id="@+id/weatherIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="0dp"
                    android:contentDescription="Weather Icon"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/weatherTemp"
                    app:layout_constraintBottom_toBottomOf="@id/weatherTemp"
                    app:layout_constraintStart_toEndOf="@id/weatherTemp" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Ώρα και Τοποθεσία -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/locationRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/titleWeatherLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <EditText
                    android:id="@+id/timeField"
                    android:layout_width="65dp"
                    android:layout_height="40dp"
                    android:hint="Ώρα"
                    android:background="#F5F5F5"
                    android:textColor="#000000"
                    android:textColorHint="#777777"
                    android:focusable="false"
                    android:clickable="true"
                    android:inputType="none"
                    android:padding="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <EditText
                    android:id="@+id/locationField"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:hint="Τοποθεσία"
                    android:padding="8dp"
                    android:background="#F5F5F5"
                    android:textColor="#000000"
                    android:textColorHint="#777777"
                    android:layout_marginStart="12dp"
                    app:layout_constraintStart_toEndOf="@id/timeField"
                    app:layout_constraintEnd_toStartOf="@id/mapsButton"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <Button
                    android:id="@+id/mapsButton"
                    android:layout_width="90dp"
                    android:layout_height="40dp"
                    android:text="Αναζήτηση"
                    android:textSize="13sp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:layout_marginStart="8dp"
                    android:includeFontPadding="false"
                    android:backgroundTint="#1A73E8"
                    android:textColor="#FFFFFF"
                    android:visibility="gone"
                    app:layout_constraintStart_toEndOf="@id/locationField"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Σημείωση -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/noteRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/locationRow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <EditText
                    android:id="@+id/noteField"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:hint="Η σημείωσή σου"
                    android:padding="8dp"
                    android:background="#F5F5F5"
                    android:textColor="#000000"
                    android:textColorHint="#777777"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/saveButton"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/saveButton"
                    android:layout_width="90dp"
                    android:layout_height="40dp"
                    android:text="Αποθήκευση"
                    android:textSize="13sp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:includeFontPadding="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1A73E8"
                    app:layout_constraintStart_toEndOf="@id/noteField"
                    app:layout_constraintEnd_toStartOf="@id/cancelButton"
                    app:layout_constraintTop_toTopOf="@id/noteField"
                    app:layout_constraintBottom_toBottomOf="@id/noteField" />

                <Button
                    android:id="@+id/cancelButton"
                    android:layout_width="70dp"
                    android:layout_height="40dp"
                    android:text="Κλείσιμο"
                    android:visibility="gone"
                    android:textSize="13sp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:includeFontPadding="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#D32F2F"
                    app:layout_constraintTop_toTopOf="@id/noteField"
                    app:layout_constraintBottom_toBottomOf="@id/noteField"
                    app:layout_constraintStart_toEndOf="@id/saveButton"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="8dp" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>