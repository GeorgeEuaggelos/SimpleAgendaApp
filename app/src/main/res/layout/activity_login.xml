<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:id="@+id/loginContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Τίτλος εφαρμογής -->
        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Schedly"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#1A73E8"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="32dp" />

        <!-- Username -->
        <EditText
            android:id="@+id/username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Όναμα Χρήστη"
            android:textColor="#000000"
            android:textColorHint="@color/edittext_text_color"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="16dp" />

        <!-- Password -->
        <EditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Κωδικός Πρόσβασης"
            android:textColor="#000000"
            android:textColorHint="@color/edittext_text_color"
            android:inputType="textPassword"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="24dp" />

        <!-- Login Button -->
        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Σύνδεση"
            android:textAllCaps="false"
            android:backgroundTint="#1A73E8"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp" />

        <!-- Fingerprint Button -->
        <Button
            android:id="@+id/fingerprintButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Σύνδεση με Δακτυλικό Αποτύπωμα"
            android:backgroundTint="#1A73E8"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp" />

        <!-- Sign up -->
        <TextView
            android:id="@+id/signupText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Δέν έχεις λογαριασμό; Κάνε εγγραφή"
            android:textColor="#1A73E8"
            android:textSize="14sp"
            android:layout_gravity="center_horizontal" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
